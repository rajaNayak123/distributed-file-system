NODE_ENV=development
AWS_REGION=us-east-1
S3_ENDPOINT=http://localhost:4566
DYNAMODB_ENDPOINT=http://localhost:8000
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/file-processing-queue
SQS_DLQ_URL=http://localhost:4566/000000000000/file-processing-dlq
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true
S3_BUCKET=file-storage-dev
DYNAMODB_FILES_TABLE=Files

CLEANUP_CRON_SCHEDULE=0 * * * *
CLEANUP_RETENTION_HOURS=24
CLEANUP_STUCK_COMPLETING_HOURS=1

RECONCILIATION_CRON_SCHEDULE=*/15 * * * *
RECONCILIATION_STUCK_MINUTES=30
RECONCILIATION_UNVERIFIED_MINUTES=15
RECONCILIATION_ORPHAN_GRACE_MINUTES=60
