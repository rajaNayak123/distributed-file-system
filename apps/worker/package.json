    "test:integration": "jest --runInBand --selectProjects integration",
    "inspect-dlq": "node scripts/inspect-dlq.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.629.0",
    "@aws-sdk/client-s3": "^3.629.0",
    "@aws-sdk/client-sqs": "^3.629.0",
    "@aws-sdk/lib-dynamodb": "^3.629.0",
    "@smithy/node-http-handler": "^3.0.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "aws-sdk-client-mock": "^4.0.1",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18"
  }
