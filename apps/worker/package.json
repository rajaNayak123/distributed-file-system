{
  "name": "distributed-file-storage-worker",
  "version": "0.1.0",
  "description": "Event-driven worker for the distributed file storage system (Phase 6: checksum, metadata validation, cleanup, reconciliation stub).",
  "type": "module",
  "main": "src/worker.js",
  "scripts": {
    "start": "node src/worker.js",
    "dev": "nodemon src/worker.js",
    "test": "jest --runInBand",
