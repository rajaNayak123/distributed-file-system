# Server & Environment
NODE_ENV=development
API_PORT=3000
FRONTEND_PORT=5173
LOCALSTACK_PORT=4566
DYNAMODB_PORT=8000
REDIS_PORT=6379

# JWT Authentication
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS & Cloud Mock Services
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localstack:4566
S3_BUCKET=file-storage-dev
S3_FORCE_PATH_STYLE=true
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
SQS_ENDPOINT=http://localstack:4566
SQS_QUEUE_URL=http://localstack:4566/000000000000/file-processing-queue
SQS_DLQ_URL=http://localstack:4566/000000000000/file-processing-dlq

# DynamoDB Tables
DYNAMODB_FILES_TABLE=Files
DYNAMODB_USERS_TABLE=Users
DYNAMODB_IDEMPOTENCY_TABLE=IdempotencyKeys
IDEMPOTENCY_TTL_SECONDS=86400

# Presigned URL & Storage Configuration
PRESIGNED_PUT_EXPIRY_SECONDS=900
PRESIGNED_GET_EXPIRY_SECONDS=300
MAX_FILE_SIZE_BYTES=5368709120
ALLOWED_CONTENT_TYPES=

# Redis & Distributed Rate Limiting
REDIS_URL=redis://redis:6379
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Worker Cron Schedules & Thresholds
CLEANUP_CRON_SCHEDULE=0 * * * *
CLEANUP_RETENTION_HOURS=24
CLEANUP_STUCK_COMPLETING_HOURS=1
RECONCILIATION_CRON_SCHEDULE=*/15 * * * *
RECONCILIATION_STUCK_MINUTES=30
RECONCILIATION_UNVERIFIED_MINUTES=15
RECONCILIATION_ORPHAN_GRACE_MINUTES=60
